{
    "name": "hamada-emam-tech/esign-uaepass",
    "description": "UAE PASS digital signature driver for hamada-emam-tech/esign: qualified PAdES signatures with the signer's UAE PASS identity.",
    "keywords": ["esign", "e-signature", "uae-pass", "uae", "digital-signature", "pades"],
    "license": "MIT",
    "type": "library",
    "require": {
        "php": "^8.2",
        "ext-json": "*",
        "hamada-emam-tech/esign": "^0.3",
        "psr/http-client": "^1.0",
        "psr/http-factory": "^1.0",
        "psr/simple-cache": "^1.0 || ^2.0 || ^3.0"
    },
    "suggest": {
        "guzzlehttp/guzzle": "A PSR-18 HTTP client, picked up automatically",
        "symfony/http-client": "A PSR-18 HTTP client, picked up automatically"
    },
    "autoload": {
        "psr-4": { "HamadaEmamTech\\Esign\\UaePass\\": "src/" }
    },
    "autoload-dev": {
        "psr-4": { "HamadaEmamTech\\Esign\\UaePass\\Tests\\": "tests/" }
    },
    "extra": {
        "esign": { "providers": { "uaepass": "HamadaEmamTech\\Esign\\UaePass\\UaePassFactory" } }
    },
    "minimum-stability": "stable"
}
